{
  "name": "api-converter",
  "version": "1.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "lint:fix": "oxlint --fix --type-aware src/ test/",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:debug": "vitest --project unit --inspect-brk --no-file-parallelism",
    "typeorm:ts": "tsx ./node_modules/typeorm/cli.js",
    "migration:create": "wrap () { pnpm typeorm:ts migration:create ./src/database/migrations/$@ | cat; }; wrap",
    "migration:generate": "pnpm typeorm:ts migration:generate -d ./src/database/data-source.ts",
    "migration:run": "pnpm typeorm:ts migration:run -d ./src/database/data-source.ts",
    "migration:revert": "pnpm typeorm:ts migration:revert -d ./src/database/data-source.ts",
    "migration:show": "pnpm typeorm:ts migration:show -d ./src/database/data-source.ts",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "test:all": "vitest run --passWithNoTests",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d --wait db-test",
    "test:infra:down": "docker compose -f docker-compose.test.yml down",
    "test:infra:migrate": "NODE_ENV=test pnpm migration:run",
    "test:docker:build": "docker compose -f docker-compose.test.yml build test-runner",
    "test:docker": "docker compose -f docker-compose.test.yml run --rm test-runner",
    "pr": "pnpm lint && pnpm format && pnpm build && pnpm test:cov --maxWorkers 4"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.1",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "nestjs-i18n": "^10.8.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.2",
    "nock": "^14.0.17",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@12.4.2"
}
